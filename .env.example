# ============================================================
# BACKEND ENVIRONMENT — copy to backend/.env
# ============================================================

# Environment: development | production
NODE_ENV=development

# Server port (dev: 5003, prod: 5002 or 443)
PORT=5003

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/TalentShield

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-strong-random-string
JWT_EXPIRES_IN=24h

# Session — generate same way as JWT_SECRET
SESSION_SECRET=replace-with-strong-random-string

# CORS — comma-separated list of allowed frontend origins
# Dev:  http://localhost:3001
# Prod: https://hrms.talentshield.co.uk
CORS_ORIGIN=http://localhost:3001

# Email (required in production, optional in development)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=noreply@talentshield.co.uk

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Logging: debug | info | warn | error
LOG_LEVEL=info


# ============================================================
# FRONTEND ENVIRONMENT — create frontend/.env.development
#                    and frontend/.env.production separately
# ============================================================
#
# frontend/.env.development  (used by: npm start / npm run dev)
# ──────────────────────────────────────────────────────────
# REACT_APP_API_BASE_URL=http://localhost:5003/api
# REACT_APP_API_URL=http://localhost:5003
#
# frontend/.env.production  (used by: npm run build)
# ──────────────────────────────────────────────────────────
# REACT_APP_API_BASE_URL=https://hrms.talentshield.co.uk/api
# REACT_APP_API_URL=https://hrms.talentshield.co.uk
